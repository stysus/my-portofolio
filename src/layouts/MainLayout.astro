---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Vibe Coder | Dark Futuristic Portfolio Foundation", 
  description = "Astro + Tailwind CSS + TypeScript Dark Futuristic Scalable Portfolio Foundation" 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Preconnect Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col font-sans antialiased selection:bg-[var(--primary-neon)] selection:text-white">
    <!-- Ambient Background Glow Accents -->
    <div class="fixed top-0 left-1/4 -translate-y-1/2 w-96 h-96 bg-[var(--primary-neon)]/15 rounded-full blur-3xl pointer-events-none z-0"></div>
    <div class="fixed top-1/3 right-10 w-96 h-96 bg-[var(--secondary-neon)]/15 rounded-full blur-3xl pointer-events-none z-0"></div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <slot name="header" />
      <main id="main-content" class="flex-grow">
        <slot />
      </main>
      <slot name="footer" />
    </div>
  </body>
</html>
