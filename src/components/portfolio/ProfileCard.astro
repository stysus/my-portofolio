---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { fetchGithubData } from '../../utils/github';

const stats = await fetchGithubData();
---

<div class="h-full">
  <!-- Main Profile Card -->
  <Card variant="glass" class="relative overflow-hidden border border-[var(--border-neon-primary)] shadow-[var(--shadow-neon-purple)] h-full flex flex-col">
    
    <!-- Top Decorative Line -->
    <div class="h-0.5 -mx-6 -mt-6 bg-gradient-to-r from-[var(--primary-neon)] via-[var(--secondary-neon)] to-[var(--accent-pink)] mb-5"></div>

    <div class="flex-1 flex flex-col items-center text-center">
      
      <!-- Avatar with Neon Pulse Ring -->
      <div class="relative mb-3.5 group inline-block">
        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-[var(--primary-neon)] via-[var(--secondary-neon)] to-[var(--accent-pink)] opacity-70 blur-sm transition duration-500 group-hover:opacity-100 animate-pulse"></div>
        <img 
          src={stats.avatarUrl || "/avatar.jpg"} 
          alt={`${stats.name} Avatar`} 
          class="relative w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover border-2 border-[var(--bg-primary)] shadow-xl"
        />
        <!-- Live Status Pill -->
        <span class="absolute -bottom-1.5 -right-1.5 px-1.5 py-0.5 rounded-full bg-[var(--bg-primary)] text-[9px] font-mono font-medium text-[var(--accent-green)] border border-[var(--accent-green)]/30 flex items-center gap-1 leading-none">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-green)] animate-ping"></span>
          Online
        </span>
      </div>

      <!-- Profile Details -->
      <h2 class="text-xl font-black text-white tracking-tight leading-tight mb-0.5">
        {stats.name || "Vibe Coder"}
      </h2>
      <a 
        href={stats.profileUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-[11px] font-mono text-[var(--primary-neon-bright)] hover:underline mb-2.5 inline-block leading-none"
      >
        @{stats.username}
      </a>

      <!-- Bio -->
      <p class="text-[11px] sm:text-xs text-[var(--text-secondary)] leading-relaxed max-w-[220px] mb-4">
        Turning ideas into real projects with AI assistance. I focus on speed, creativity, and solving real problems.
      </p>

      <!-- Stats Row -->
      <div class="w-full grid grid-cols-3 gap-1.5 py-2.5 px-2 rounded-[var(--radius-lg)] bg-[var(--bg-primary)]/50 border border-[var(--border-subtle)]/60 mb-4">
        <div class="flex flex-col items-center gap-0.5">
          <span class="text-base font-black text-white font-mono tabular-nums leading-none">{stats.publicRepos}</span>
          <span class="text-[9px] font-mono text-[var(--text-muted)] uppercase tracking-wider leading-none">Repos</span>
        </div>
        <div class="flex flex-col items-center gap-0.5 border-x border-[var(--border-subtle)]/40">
          <span class="text-base font-black text-[var(--secondary-neon-bright)] font-mono tabular-nums leading-none">{stats.starsCount}</span>
          <span class="text-[9px] font-mono text-[var(--text-muted)] uppercase tracking-wider leading-none">Stars</span>
        </div>
        <div class="flex flex-col items-center gap-0.5">
          <span class="text-base font-black text-[var(--primary-neon-bright)] font-mono tabular-nums leading-none">{stats.followers}</span>
          <span class="text-[9px] font-mono text-[var(--text-muted)] uppercase tracking-wider leading-none">Followers</span>
        </div>
      </div>

      <!-- Unified Social Action Row -->
      <div class="w-full flex items-center justify-between px-3 py-2.5 rounded-[var(--radius-lg)] bg-[var(--surface-elevated)]/50 border border-[var(--border-subtle)]/50 mb-4">
        <span class="text-[10px] font-mono text-[var(--text-muted)] font-semibold uppercase tracking-wider leading-none">Connect</span>
        <div class="flex items-center gap-1.5">
          <a 
            href={stats.profileUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="p-1.5 rounded-lg bg-[var(--bg-primary)] text-[var(--text-secondary)] hover:text-white hover:bg-[var(--primary-neon)]/20 transition-all duration-200 border border-[var(--border-subtle)]/60"
            aria-label="GitHub Profile"
            title={`GitHub @${stats.username}`}
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a 
            href="#" 
            class="p-1.5 rounded-lg bg-[var(--bg-primary)] text-[var(--text-secondary)] hover:text-[var(--secondary-neon-bright)] hover:bg-[var(--secondary-neon)]/20 transition-all duration-200 border border-[var(--border-subtle)]/60"
            aria-label="X Twitter Profile"
            title="X / Twitter"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a 
            href="#" 
            class="p-1.5 rounded-lg bg-[var(--bg-primary)] text-[var(--text-secondary)] hover:text-[var(--primary-neon-bright)] hover:bg-[var(--primary-neon)]/20 transition-all duration-200 border border-[var(--border-subtle)]/60"
            aria-label="Discord Contact"
            title="Discord"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          </a>
        </div>
      </div>

      <!-- Futuristic Quote Card -->
      <div class="w-full text-left p-3 rounded-[var(--radius-lg)] bg-[var(--surface-elevated)]/70 border border-[var(--primary-neon)]/20 relative overflow-hidden group mt-auto">
        <div class="absolute top-1.5 right-2 text-[var(--primary-neon)]/10 text-3xl font-serif font-black select-none leading-none">"</div>
        <div class="flex items-start gap-1.5 relative z-10">
          <span class="text-[var(--primary-neon-bright)] text-sm leading-none mt-0.5 shrink-0">"</span>
          <p class="text-[11px] font-medium text-white/90 italic leading-snug flex-1">
            Prompt the idea. Trust the process. Ship the vibe.
          </p>
          <span class="text-xs text-[var(--accent-pink-glow)] shrink-0 leading-none mt-0.5">⚡</span>
        </div>
      </div>

    </div>
  </Card>
</div>
