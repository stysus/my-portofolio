---
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { size = 'lg', class: className = '' } = Astro.props;

const sizeStyles = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-6xl',
  xl: 'max-w-7xl'
};
---

<div class:list={['w-full mx-auto px-4 sm:px-6 lg:px-8', sizeStyles[size], className]}>
  <slot />
</div>
